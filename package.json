{
	"name": "light-system-starter",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun scripts/build-static.ts && bun scripts/verify-static.ts",
		"db:migration:new": "bun scripts/noumi-db-schema.ts migration:new",
		"db:schema:write": "bun scripts/noumi-db-schema.ts schema:write",
		"db:validate": "bun scripts/noumi-db-schema.ts validate",
		"verify": "bun scripts/verify-static.ts",
		"typecheck": "bun ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.client.json && bun ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.tooling.json"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.16.0",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"@typescript/native": "npm:typescript@7.0.2",
		"typescript": "6.0.2",
		"vite": "^8.2.0"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"bun-types": "^1.3.14"
	}
}
